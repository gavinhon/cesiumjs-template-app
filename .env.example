# Settings for docker-compose.yml. Copy to .env (which git ignores) and edit.
# See docs/deployment-docker.md.
#
# Windows paths: use forward slashes (C:/gis/data). Backslashes work
# unquoted, but inside double quotes .env treats them as escapes.

# The datasets folder, mounted read-only into the app at /data. Laid out
# like public/ in dev: terrain/<name>/layer.json, tilesets/<name>/tileset.json,
# basemaps/<name>/{z}/{x}/{y}.png, any *.geojson.
DATA_DIR=C:/gis/data

# Port on this machine the app is served on: http://localhost:8080
HTTP_PORT=8080

# true: hide everything that needs the internet — online basemaps, place
# search (unless NOMINATIM_URL is set), example services, the I3S geoid
# service. Set false on a connected network to get them back.
APP_OFFLINE=true

# Basemap to start on, by id. Local basemaps' ids are "public:" plus their
# path, e.g. public:basemaps/singapore-ortho. Empty: the first local
# basemap offline (else Natural Earth), Esri World Imagery online.
DEFAULT_BASEMAP=

# Your own Nominatim server for place search, as the *container* reaches
# it — the app proxies it at /nominatim/, so browsers need no access to it.
# With the compose "geocoder" profile: http://nominatim:8080
# Another machine: http://10.0.0.5:8080   This PC: http://host.docker.internal:8080
NOMINATIM_URL=

# Folder of source GeoTIFFs for the terrain tool (mounted read-only at /input).
TERRAIN_INPUT_DIR=C:/gis/terrain-sources

# The optional Nominatim container: folder holding the .osm.pbf extract,
# and its file name.
NOMINATIM_EXTRACT_DIR=C:/gis/osm
NOMINATIM_PBF=malaysia-singapore-brunei-latest.osm.pbf
