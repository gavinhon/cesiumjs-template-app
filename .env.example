# Copy to .env (gitignored). Read by docker-compose.yml and by `npm run dev`.
# Windows paths: forward slashes (C:/gis/data).

# Datasets folder, laid out like public/ (terrain/, tilesets/, basemaps/, *.geojson).
DATA_DIR=C:/gis/data
HTTP_PORT=8080

# true hides everything that needs the internet.
APP_OFFLINE=true

# Basemap id to start on (e.g. public:basemaps/singapore-ortho); empty for the default.
DEFAULT_BASEMAP=

# Your own Nominatim for place search, as the container reaches it (e.g. http://nominatim:8080).
NOMINATIM_URL=

# LTA DataMall key: live traffic congestion and incidents (online only). Empty: none.
LTA_ACCOUNT_KEY=

# Terrain tool: source GeoTIFF folder.
TERRAIN_INPUT_DIR=C:/gis/terrain-sources

# Optional Nominatim container: .osm.pbf folder and file.
NOMINATIM_EXTRACT_DIR=C:/gis/osm
NOMINATIM_PBF=malaysia-singapore-brunei-latest.osm.pbf
