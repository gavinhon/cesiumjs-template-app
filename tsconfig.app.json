{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* `@/...` resolves to `src/...`, so a module never has to reach across
       the tree with `../../`. Paths are relative to this file's directory
       (no `baseUrl` — it's deprecated as of TypeScript 6). Vite needs the
       same mapping to resolve these at build time; see the `resolve.alias`
       in vite.config.ts, and keep the two in sync. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Type checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
