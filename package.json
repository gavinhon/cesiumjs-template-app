{
  "name": "cesiumjs-template-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:terrain-script": "python -m unittest discover -s scripts -v",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "preview": "vite preview",
    "prepare": "node -e \"const f='scripts/installGitHooks.mjs';if(require('fs').existsSync(f))require('child_process').execFileSync(process.execPath,[f],{stdio:'inherit'})\""
  },
  "dependencies": {
    "cesium": "^1.140.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
